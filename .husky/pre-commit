#!/bin/sh

set -e

# husky always runs the main checkout's copy; $0 is not the committing worktree
cd "$(git rev-parse --show-toplevel)"

staged_files="$(git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r f; do [ -L "$f" ] || printf '%s\n' "$f"; done)"

if [ -n "$staged_files" ]; then
  echo "Formatting staged files..."
  # NUL-separated, because docs paths contain spaces
  printf '%s\n' "$staged_files" | tr '\n' '\0' | xargs -0 bunx prettier --write --ignore-unknown
  printf '%s\n' "$staged_files" | tr '\n' '\0' | xargs -0 git add --
else
  echo "No staged files to format."
fi

echo "Type checking..."
bunx tsc

echo "Linting..."
bun run lint

echo "Pre-commit checks passed!"
