{
  "name": "otr",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "bun run --filter '*' --parallel lint",
    "build": "bun run --filter '*' --parallel build",
    "start": "bun run --filter '*' --parallel start",
    "dev": "bun run --filter web dev",
    "dev:all": "bun run --filter '*' --parallel dev",
    "dev:worker": "bun run --filter data-worker dev",
    "format": "bunx prettier . --write"
  },
  "dependencies": {
    "dotenv": "^18.0.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  }
}
