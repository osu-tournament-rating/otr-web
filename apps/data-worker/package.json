{
  "name": "data-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/data-worker",
    "lint": "bunx eslint src --ext .ts --cache --cache-location node_modules/.cache/eslint/",
    "test": "bun test",
    "attributes:worker": "bun run src/beatmap-attributes/worker.ts",
    "attributes": "bun run src/beatmap-attributes/cli.ts",
    "stats:players": "bun run src/platform-stats/cli.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "7.19.0",
    "@otr/core": "workspace:*",
    "amqplib": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "rosu-pp-js": "4.0.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "bun-types": "^1.3.14"
  }
}
